# Plantorq — Docker Compose configuration
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# .env is git-ignored. Replace every "change-me" before exposing the stack
# beyond your machine; generate secrets with: openssl rand -hex 32

# --- Secrets (required: Compose refuses to start without them) -------------
POSTGRES_PASSWORD=change-me-postgres-password
# At least 32 characters; the API refuses shorter keys.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# --- Demo data ---------------------------------------------------------------
# When set, the API seeds a demo tenant on an empty database with
# admin@acme.io, operator@acme.io and viewer@acme.io using this password.
# Leave empty to start with an empty platform.
SEED_DEMO_PASSWORD=plantorq-demo

# --- Databases -----------------------------------------------------------------
POSTGRES_USER=plantorq
POSTGRES_DB=plantorq
INFLUX_DB=plantorq

# --- MQTT (the dev broker allows anonymous clients; set these with ACLs) -----
MQTT_USERNAME=
MQTT_PASSWORD=

# --- API -----------------------------------------------------------------------
# Session lifetime (Go duration: 30m, 12h, ...).
JWT_TTL=12h
# Extra browser origins allowed for CORS/WebSocket, comma separated. Not
# needed when the dashboard is served by the bundled nginx (same origin).
CORS_ORIGINS=

# --- Pipeline tuning -------------------------------------------------------------
INGEST_BATCH_SIZE=500
INGEST_FLUSH_INTERVAL=1s
INGEST_QUEUE_SIZE=20000
RULE_RELOAD_INTERVAL=15s
# Analytics: metrics scored for anomalies, and rolling window size (samples).
ANALYTICS_WATCHED_METRICS=vibration
ANALYTICS_WINDOW=120

# --- Logging -----------------------------------------------------------------------
# Shared by every service (case-insensitive): debug | info | warning | error.
LOG_LEVEL=info
