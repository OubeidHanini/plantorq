# Keys of the "plantorq-secrets" Secret every Kubernetes overlay must provide.
#
# Never commit real values. In production, create the Secret from a secret
# manager (External Secrets Operator, Sealed Secrets, Vault...) or locally:
#
#   kubectl -n plantorq create secret generic plantorq-secrets --from-env-file=secrets.env
#
# Generate random values with: openssl rand -hex 32

POSTGRES_PASSWORD=change-me
# Must embed the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgres://plantorq:change-me@postgres:5432/plantorq?sslmode=disable
# At least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: seeds a demo tenant on an empty database. Leave empty in production.
SEED_DEMO_PASSWORD=
# Optional: broker credentials once MQTT ACLs are enabled.
MQTT_USERNAME=
MQTT_PASSWORD=
