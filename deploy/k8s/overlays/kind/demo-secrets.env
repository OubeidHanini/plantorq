# DEMO / CI ONLY. These throwaway values let the kind overlay (local tests and
# the GitHub Actions end-to-end job) run without any setup. They protect
# nothing; real clusters get "plantorq-secrets" from a secret manager instead
# (see ../../secrets.env.example).
POSTGRES_PASSWORD=plantorq-demo
DATABASE_URL=postgres://plantorq:plantorq-demo@postgres:5432/plantorq?sslmode=disable
JWT_SECRET=demo-only-jwt-secret-for-kind-and-ci-not-for-production
GRAFANA_ADMIN_PASSWORD=plantorq-demo
SEED_DEMO_PASSWORD=plantorq-demo
MQTT_USERNAME=
MQTT_PASSWORD=
